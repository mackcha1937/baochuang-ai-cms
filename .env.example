# 复制本文件为 .env，再由项目负责人本人填写真实密钥。不要提交或分享 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DASHSCOPE_API_KEY=
# 必须与 API Key、模型和 Endpoint 属于同一地域。推荐填写业务空间 ID 使用新版专属域名。
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=beijing
# 可选：只有自定义地域/专属 Endpoint 时填写；否则留空由上面两项自动解析。
DASHSCOPE_API_BASE_URL=
QWEN_IMAGE_MODEL=qwen-image-3.0
QWEN_IMAGE_TIMEOUT_SECONDS=180
APP_DATABASE_URL=sqlite:///data/baochuang.db
APP_GENERATED_DIR=data/generated
APP_MAX_VISUAL_BYTES=15728640
APP_HOST=127.0.0.1
APP_PORT=8765
APP_LOG_LEVEL=info
